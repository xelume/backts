{
  "name": "create-backts",
  "version": "0.0.5",
  "type": "module",
  "description": "Create a BackTS application.",
  "engines": {
    "node": ">=24"
  },
  "bin": {
    "create-backts": "bin.mjs"
  },
  "files": [
    "bin.mjs",
    "dist",
    "README.md"
  ],
  "publishConfig": {
    "registry": "https://registry.qlqs.work/"
  },
  "scripts": {
    "build": "tsdown src/bin.ts --format esm --platform node --target node24",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "prepack": "pnpm typecheck && pnpm build",
    "pack:dry-run": "pnpm pack --dry-run"
  },
  "dependencies": {
    "@backts/cli": "workspace:*"
  },
  "devDependencies": {
    "tsdown": "0.23.0"
  }
}
