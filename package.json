{
  "name": "backts",
  "version": "0.0.3",
  "private": true,
  "type": "module",
  "description": "BackTS: build native backend services with TypeScript.",
  "packageManager": "pnpm@10.33.4",
  "scripts": {
    "dev": "pnpm --filter @backts/example-todo dev",
    "build": "pnpm -r --if-present build",
    "start": "pnpm --filter @backts/example-todo start",
    "typecheck": "pnpm -r typecheck && tsc -p tsconfig.json",
    "analyze": "pnpm -r --if-present analyze",
    "test": "pnpm -r --if-present test:build && node --test tests/cli/*.test.ts tests/integration/*.test.ts",
    "check": "pnpm build && pnpm typecheck && pnpm analyze && pnpm test",
    "coverage": "pnpm analyze",
    "release:check": "pnpm check && node scripts/checkProjectVersions.ts && pnpm pack:check",
    "changeset": "changeset",
    "changeset:check": "node scripts/checkChangesets.ts",
    "version-packages": "pnpm changeset:check && pnpm changeset version",
    "pack:check": "pnpm --recursive --workspace-concurrency=1 --filter './packages/*' --if-present run pack:dry-run",
    "release": "node scripts/releasePackages.ts"
  },
  "devDependencies": {
    "@backts/cli": "workspace:*",
    "@changesets/cli": "^3.0.2",
    "@types/node": "26.4.0",
    "typescript": "7.0.2"
  }
}
